# App Environment
ENVIRONMENT=development
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Settings
POSTGRES_USER=devmentor_user
POSTGRES_PASSWORD=devmentor_pass
POSTGRES_DB=devmentor_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devmentor_user:devmentor_pass@postgres:5432/devmentor_db

# Qdrant Vector DB
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
MASTERY_ALPHA=0.30
